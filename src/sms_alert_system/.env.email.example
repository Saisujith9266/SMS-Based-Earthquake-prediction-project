# Copy values into your local .env file. Never commit real credentials.
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email via Gmail SMTP (use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=

# Keep true until you deliberately want real external messages
SIMULATION_MODE=true
DEFAULT_RADIUS_KM=50
DATABASE_URL=sqlite:///earthquake_alerts.db
